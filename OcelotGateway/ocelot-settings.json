{
  "Routes": [
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "webapi01",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/webapi01/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS",
        "HEAD"
      ],
        "UpstreamScheme": "http",
      "UpstreamHeaderTransform": {
        "X-Request-Source": "Ocelot",
        "x-datadog-trace-id": "{TraceId}",
        "RequestTraceId": "{TraceId}"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": false,
        "ClientWhitelist": [],
        "RateLimitCounterPrefix": "ocelot-rate-limit",
        "DisableRateLimitHeaders": false,
        "HttpStatusCode": 429,
        "ClientIdHeader": "Client-Id",
        "Period": "1m",
        "PeriodTimespan": 1,
        "Limit": 5
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "SwaggerEndPoints": [
        {
          "Key": "webapi01",
          "Config": [
            {
              "Name": "Web API 01",
              "Version": "v1",
              "Url": "http://webapi01:8080/swagger/v1/swagger.json"
            }
          ]
        }
      ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "webapi02",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/webapi02/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS",
        "HEAD"
      ],
      "UpstreamScheme": "http",
      "UpstreamHeaderTransform": {
        "X-Request-Source": "Ocelot",
        "x-datadog-trace-id": "{TraceId}",
        "RequestTraceId": "{TraceId}"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": false,
        "ClientWhitelist": [],
        "RateLimitCounterPrefix": "ocelot-rate-limit",
        "DisableRateLimitHeaders": false,
        "HttpStatusCode": 429,
        "ClientIdHeader": "Client-Id",
        "Period": "1m",
        "PeriodTimespan": 1,
        "Limit": 5
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/api/v2/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "pokeapi.co",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/pokemon/{everything}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": false,
        "ClientWhitelist": [],
        "RateLimitCounterPrefix": "pokemon-rate-limit",
        "DisableRateLimitHeaders": false,
        "HttpStatusCode": 429,
        "ClientIdHeader": "Client-Id",
        "Period": "1m",
        "PeriodTimespan": 1,
        "Limit": 3
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}