{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "YARP": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "pokemon": {
        "ClusterId": "pokemon-cluster",
        "Match": {
          "Path": "/api/pokemon/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/pokemon"
          }
        ]
      },
      "webapi01": {
        "ClusterId": "webapi01-cluster",
        "Match": {
          "Path": "/api/webapi01/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/webapi01"
          },
          {
            "RequestHeader": "X-Request-Source",
            "Set": "YARP"
          }
        ]
      },
      "webapi02": {
        "ClusterId": "webapi02-cluster",
        "AuthorizationPolicy": "default-authorization-policy",
        "Match": {
          "Path": "/api/webapi02/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/webapi02"
          },
          {
            "RequestHeader": "X-Request-Source",
            "Set": "YARP"
          }
        ]
      }
    },
    "Clusters": {
      "pokemon-cluster": {
        "Destinations": {
          "poke": {
            "Address": "https://pokeapi.co/api/v2"
          }
        }
      },
      "webapi01-cluster": {
        "Destinations": {
          "webapi01": {
            "Address": "http://webapi01:8080"
          }
        }
      },
      "webapi02-cluster": {
        "Destinations": {
          "webapi02": {
            "Address": "http://webapi02:8080"
          }
        }
      }
    },
    "RateLimiterPolicies": {
      "fixedFiveReq": {
        "PermitLimit": 5,
        "Window": "00:01:00"
      }
    }
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  }
}
