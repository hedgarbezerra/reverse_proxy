{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "YARP": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "pokemon": {
        "ClusterId": "pokemon-cluster",
        "Match": {
          "Path": "/api/pokemon/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/pokemon"
          }
        ]
      },
      "webapi01": {
        "ClusterId": "webapi01-cluster",
        "Match": {
          "Path": "/api/webapi01/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/webapi01"
          },
          {
            "RequestHeader": "X-Request-Source",
            "Set": "YARP"
          }
        ]
      },
      "webapi02": {
        "ClusterId": "webapi02-cluster",
        "AuthorizationPolicy": "AzureAdAdmin",
        "Match": {
          "Path": "/api/webapi02/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/webapi02"
          },
          {
            "RequestHeader": "X-Request-Source",
            "Set": "YARP"
          }
        ]
      },
      "redemption-center": {
        "ClusterId": "redemption-center-cluster",
        "Match": {
          "Path": "/api/{version}/redemption-center/{**catch-all}"
        },
        "RateLimiterPolicy": "fixedCode",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "PathRemovePrefix": "/{version}/redemption-center"
          },
          {
            "PathPrefix": "/{version}"
          }
        ]
      }
    },
    "Clusters": {
      "pokemon-cluster": {
        "Destinations": {
          "poke": {
            "Address": "https://pokeapi.co/api/v2"
          }
        }
      },
      "webapi01-cluster": {
        "Destinations": {
          "webapi01": {
            "Address": "http://webapi01:8080"
          }
        }
      },
      "webapi02-cluster": {
        "Destinations": {
          "webapi02": {
            "Address": "http://webapi02:8080"
          }
        }
      },
      "redemption-center-cluster": {
        "Destinations": {
          "redemption-center": {
            "Address": "http://localhost:rctotal"
          }
        }
      }
    },
    "RateLimiterPolicies": {
      "fixedOld": {
        "PermitLimit": 5,
        "Window": "00:01:00"
      }
    }
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  },
  "AzureAdAdmin": {
    "Instance": "<instance>",
    "ClientId": "<client-id>",
    "ClientSecret": "<client-secret>",
    "Audience": "<audience>",
    "AdminUserId": "<admin-user-id>",
    "AppRegistration": {
      "Id": "<app-registration-id>",
      "ServicePrincipalId": "<service-principal-id>"
    },
    "TenantId": "<tenant-id>",
    "AllowWebApiToBeAuthorizedByACL": true,
    "Scopes": "<scopes>"
  }
}
